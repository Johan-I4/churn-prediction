# Copia este archivo a .env y completa los valores. .env NO se sube a GitHub.
# Sin API key todo funciona con LLM_BACKEND=template (el valor por defecto).

# template (defecto, sin red) | anthropic | auto
LLM_BACKEND=template

# Solo si usas el backend anthropic:
ANTHROPIC_API_KEY=tu_clave_aqui
LLM_MODEL=
